{
  "name": "mneme-monorepo",
  "version": "2.19.99",
  "private": true,
  "type": "module",
  "description": "Mneme เนโฌโ€ the memory layer for your codebase. Knows the WHY, the WHAT, the WHERE-IT-BREAKS, all in one graph.",
  "workspaces": [
    "packages/core",
    "packages/embeddings",
    "packages/cli",
    "packages/mcp",
    "packages/correlator",
    "packages/web",
    "packages/vscode"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/embeddings packages/mcp packages/correlator packages/cli",
    "build:watch": "tsc -b -w packages/core packages/embeddings packages/mcp packages/correlator packages/cli",
    "clean": "tsc -b --clean packages/core packages/embeddings packages/mcp packages/correlator packages/cli && rimraf packages/*/dist coverage tests/.tmp",
    "dev": "node packages/cli/bin/mneme.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -b --noEmit packages/core packages/embeddings packages/mcp packages/cli packages/correlator",
    "eval": "node --import tsx tests/eval/run-eval.ts",
    "bench": "node --import tsx bench/run-bench.ts",
    "status": "node --import tsx tests/status/generate-status.ts",
    "format": "prettier --write \"packages/**/*.{ts,js,json,md}\" \"tests/**/*.ts\" \"bench/**/*.ts\"",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm --output-format JSON --output-file sbom.json && echo \"wrote sbom.json (CycloneDX)\"",
    "release": "node scripts/release.mjs",
    "ship-readiness": "node scripts/ship-readiness.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "fast-check": "^4.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.13.0 <25.0.0"
  },
  "overrides": {
    "html-escaper": "^2.0.0",
    "pathval": "^2.0.0",
    "commander": "^14.0.3"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patsa2561-art/mneme-ai.git"
  }
}
