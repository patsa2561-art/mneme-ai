{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.patsa2561-art/mneme-ai",
  "title": "Mneme",
  "description": "Memory layer for AI coding assistants. Indexes git history + code, exposes via MCP.",
  "repository": {
    "url": "https://github.com/patsa2561-art/mneme-ai",
    "source": "github"
  },
  "version": "3.94.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mneme-ai",
      "version": "3.94.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        },
        {
          "type": "positional",
          "value": "mneme-ai"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
