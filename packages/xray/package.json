{
  "name": "@mneme-ai/xray",
  "version": "2.178.0",
  "description": "Mneme Repo X-Ray — a signed, raw-free, deterministic X-Ray of any repo. Every number is reproducible from git/AST/metadata and sealed with an offline-verifiable NOTARY receipt. No source code ever leaves the machine; no LLM guesses anything.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mneme-xray": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patsa2561-art/mneme-ai.git",
    "directory": "packages/xray"
  },
  "homepage": "https://github.com/patsa2561-art/mneme-ai#readme",
  "bugs": {
    "url": "https://github.com/patsa2561-art/mneme-ai/issues"
  },
  "license": "MIT",
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "serve": "node dist/server.js"
  },
  "keywords": [
    "ai",
    "repo-analysis",
    "x-ray",
    "deterministic",
    "notary",
    "signed",
    "privacy",
    "bus-factor",
    "dependency-mortality",
    "mneme"
  ],
  "dependencies": {
    "@mneme-ai/core": "2.175.0",
    "@resvg/resvg-js": "^2.6.2"
  },
  "engines": {
    "node": ">=22.13.0 <25.0.0"
  }
}
