{
  "name": "@mneme-ai/mcp",
  "version": "3.17.0",
  "description": "MCP server that exposes Mneme to Claude Code, Cursor, Continue, and other AI clients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tools/registry": {
      "import": "./dist/tools/_registry.js",
      "types": "./dist/tools/_registry.d.ts"
    },
    "./tools/squadron": {
      "import": "./dist/tools/_squadron.js",
      "types": "./dist/tools/_squadron.d.ts"
    },
    "./tools/runtime": {
      "import": "./dist/tools/_runtime.js",
      "types": "./dist/tools/_runtime.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patsa2561-art/mneme-ai.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/patsa2561-art/mneme-ai#readme",
  "bugs": {
    "url": "https://github.com/patsa2561-art/mneme-ai/issues"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "engines": {
    "node": ">=22.13.0 <25.0.0"
  },
  "dependencies": {
    "@mneme-ai/core": "3.17.0",
    "@mneme-ai/embeddings": "3.17.0",
    "@mneme-ai/xray": "3.17.0",
    "@modelcontextprotocol/sdk": "^1.0.4"
  }
}
